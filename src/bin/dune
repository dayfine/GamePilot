(rule
 (target version.ml)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let version = \"%{env:GAMEPILOT_VERSION=dev}\"\n")
    (echo "let git_sha = \"%{env:GAMEPILOT_GIT_SHA=unknown}\"\n")))))

