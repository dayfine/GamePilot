(executables
 (names print_plan_errors print_kept_files)
 (modules print_plan_errors print_kept_files)
 (libraries yojson gamepilot.pokemon_engine))

(rule
 (action
  (with-stdout-to
   plan_errors.txt
   (run ./print_plan_errors.exe))))

(rule
 (alias runtest)
 (action
  (diff plan_errors.golden plan_errors.txt)))

(rule
 (action
  (with-stdout-to
   kept_files.txt
