(executable
 (name print_plans)
 (modules print_plans)
 (libraries
  gamepilot.repo_io
  gamepilot.pokemon_checkpoints
  gamepilot.frlg_checkpoints))

(rule
 (deps
  (glob_files_rec ../../programs/*.plan.json))
 (action
  (with-stdout-to
   plans.txt
   (run ./print_plans.exe ../../programs))))

(rule
 (alias runtest)
 (action
  (diff plans.golden plans.txt)))
